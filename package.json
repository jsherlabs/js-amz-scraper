{
  "name": "js-amz-scraper",
  "version": "1.0.0",
  "description": "Reusable Amazon web scrapers that extract product data from any Amazon URL (stores, search results, categories). Available in both JavaScript and Python.",
  "main": "src/scrapers/amazon_scraper_generic.js",
  "scripts": {
    "scrape": "node src/scrapers/amazon_scraper_generic.js",
    "scrape:v2": "node src/scrapers/amazon_scraper_v2.js",
    "scrape:v3": "node src/scrapers/amazon_scraper_v3.js",
    "scraper": "node src/cli/scraper-cli.js",
    "product": "node src/scrapers/amazon_product_detail.js",
    "reviews": "node src/scrapers/amazon_reviews.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest test/unit --coverage",
    "test:python": "pytest test/ -v --cov=src/scrapers --cov-report=term-missing",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\"",
    "format:python": "black src/scrapers test/",
    "lint:python": "pylint src/scrapers/*.py",
    "quality": "npm run format:check && npm run lint",
    "prepare": "husky install"
  },
  "keywords": [
    "amazon",
    "scraper",
    "web-scraping",
    "playwright",
    "automation",
    "ecommerce",
    "data-extraction",
    "product-scraper"
  ],
  "author": "Jason Sher",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.0",
    "objects-to-csv": "^1.3.6",
    "playwright": "^1.40.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "winston": "^3.11.0"
  },
  "optionalDependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.0.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jslabxyz/js-amz-scraper.git"
  },
  "bugs": {
    "url": "https://github.com/jslabxyz/js-amz-scraper/issues"
  },
  "homepage": "https://github.com/jslabxyz/js-amz-scraper#readme"
}
