# Amazon Scraper Configuration
# Copy this file to .env and customize as needed

# Browser Settings
HEADLESS=true
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
LOCALE=en-GB
TIMEZONE=Europe/London
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36...

# Timeouts (in milliseconds)
NAVIGATION_TIMEOUT=60000
COOKIE_TIMEOUT=3000
GRID_TIMEOUT=10000
PAGE_LOAD_TIMEOUT=3000

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY=1000
RETRY_MAX_DELAY=30000
RETRY_BACKOFF=2

# Scraping Settings
MAX_FALLBACK_PRODUCTS=50
MIN_TITLE_LENGTH=3
WAIT_NETWORK_IDLE=true

# Data Validation
REQUIRE_TITLE=true
REQUIRE_PRICE=false
REQUIRE_IMAGE=false
REQUIRE_LINK=false
REQUIRE_ASIN=false

# Output Settings
DEFAULT_OUTPUT_FILE=amazon_output.csv
SAMPLE_OUTPUT_SIZE=3

# Logging
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_FILE=false
LOG_DIR=logs
LOG_FILENAME=scraper.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# === Phase 3 Features (V3 Scraper) ===

# Pagination Settings
ENABLE_PAGINATION=false
MAX_PAGES=5
PAGINATION_WAIT=3000
PAGINATION_STOP_ON_EMPTY=true
PAGINATION_DEDUPE=true

# Rate Limiting
ENABLE_RATE_LIMIT=false
RATE_LIMIT_MIN_DELAY=1000
RATE_LIMIT_MAX_DELAY=5000
RATE_LIMIT_RANDOMIZE=true
REQUESTS_PER_MINUTE=10

# Concurrent Processing
MAX_WORKERS=3
WORKER_TIMEOUT=300000
CONTINUE_ON_ERROR=true
SHARE_BROWSER_CONTEXT=false

# Export Formats (comma-separated: csv, json, xlsx)
EXPORT_FORMATS=csv
JSON_PRETTY=false
INCLUDE_METADATA=false
EXCEL_SHEET_NAME=Products

# Resume Capability
ENABLE_RESUME=false
RESUME_STATE_FILE=.scraper_state.json
RESUME_SAVE_INTERVAL=10
AUTO_RECOVER=true

# Custom Selectors (Advanced)
# COOKIE_SELECTOR=#sp-cc-accept
# GRID_SELECTOR=[class*="ProductGridItem"], [data-component-type="s-search-result"]
# PRODUCT_SELECTOR=[class*="ProductGridItem"], [data-component-type="s-search-result"], [data-asin]:not([data-asin=""])
