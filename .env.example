# Amazon Scraper Configuration
# Copy this file to .env and customize as needed

# Browser Settings
HEADLESS=true
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
LOCALE=en-GB
TIMEZONE=Europe/London
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36...

# Timeouts (in milliseconds)
NAVIGATION_TIMEOUT=60000
COOKIE_TIMEOUT=3000
GRID_TIMEOUT=10000
PAGE_LOAD_TIMEOUT=3000

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY=1000
RETRY_MAX_DELAY=30000
RETRY_BACKOFF=2

# Scraping Settings
MAX_FALLBACK_PRODUCTS=50
MIN_TITLE_LENGTH=3
WAIT_NETWORK_IDLE=true

# Data Validation
REQUIRE_TITLE=true
REQUIRE_PRICE=false
REQUIRE_IMAGE=false
REQUIRE_LINK=false
REQUIRE_ASIN=false

# Output Settings
DEFAULT_OUTPUT_FILE=amazon_output.csv
SAMPLE_OUTPUT_SIZE=3

# Logging
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_FILE=false
LOG_DIR=logs
LOG_FILENAME=scraper.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Custom Selectors (Advanced)
# COOKIE_SELECTOR=#sp-cc-accept
# GRID_SELECTOR=[class*="ProductGridItem"], [data-component-type="s-search-result"]
# PRODUCT_SELECTOR=[class*="ProductGridItem"], [data-component-type="s-search-result"], [data-asin]:not([data-asin=""])
