# Amazon Scraper API Configuration
# Copy this file to .env and update with your configuration

# Server Configuration
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
BODY_LIMIT=10mb

# CORS Configuration
CORS_ORIGIN=*

# Database
DB_PATH=./amazon_scraper.db

# Authentication (JWT)
ENABLE_AUTH=false
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Redis (for job queue - optional)
ENABLE_QUEUE=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Scraper Configuration
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT=300000
DEFAULT_MAX_PAGES=5

# API Features
ENABLE_SWAGGER=true
