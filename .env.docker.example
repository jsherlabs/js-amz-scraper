# Amazon Scraper - Docker Environment Configuration
# Copy this file to .env and customize as needed

# ============================================
# SERVICE PORTS
# ============================================
API_PORT=3000
FRONTEND_PORT=80
REDIS_PORT=6379

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production
LOG_LEVEL=info

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# API URL for frontend (used during build)
# For local Docker: http://localhost:3000
# For production: https://your-domain.com
VITE_API_URL=http://localhost:3000

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Enable JWT authentication
ENABLE_AUTH=false

# JWT secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS origin (* allows all, or specify: http://localhost:3000,https://yourdomain.com)
CORS_ORIGIN=*

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ============================================
# REDIS & JOB QUEUE
# ============================================
# Enable background job queue (requires Redis)
ENABLE_QUEUE=false

# Redis connection
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# API FEATURES
# ============================================
# Enable Swagger API documentation at /api/docs
ENABLE_SWAGGER=true

# ============================================
# SCRAPING SETTINGS
# ============================================
# Maximum concurrent scraping jobs
MAX_CONCURRENT_JOBS=3

# Default scraping timeout (ms)
SCRAPE_TIMEOUT=60000

# ============================================
# DATABASE
# ============================================
# Database path (inside container)
DB_PATH=/usr/src/app/data/amazon_scraper.db

# ============================================
# MONITORING & DEBUGGING
# ============================================
# Enable detailed debug logging
DEBUG=false

# Enable performance monitoring
ENABLE_MONITORING=false
